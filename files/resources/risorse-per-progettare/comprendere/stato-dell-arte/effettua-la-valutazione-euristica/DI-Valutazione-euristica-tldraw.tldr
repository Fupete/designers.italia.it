ra trovi le preferenze. \nPuoi, ad esempio, attivare e disattivare \"tema scuro\" o la funzione di allineamento oggetti.","font":"sans","autoSize":false,"scale":1,"textAlign":"start"},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"a1V","id":"shape:F9bltQsegfZgwlSJDL1fm","typeName":"shape"},{"x":102.6268375057789,"y":265.8772289628646,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"image","props":{"w":267.5252438518455,"h":286.06659738613183,"assetId":"asset:-1074340237","playing":true,"url":"","crop":null},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aD","id":"shape:wiyoTYpJI9CBuVl69YlyA","typeName":"shape"},{"x":142.76660088307835,"y":190.0270119132033,"rotation":0,"isLocked":false,"opacity":0.5,"meta":{},"type":"highlight","props":{"segments":[{"type":"straight","points":[{"x":0,"y":0,"z":0.5},{"x":30.298137566666036,"y":0,"z":1}]}],"color":"black","size":"s","isComplete":true,"isPen":false,"scale":1},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"Zy","id":"shape:2yffBrXk55w-BqePWoDJp","typeName":"shape"},{"x":6466.554400572249,"y":2942.1298409609635,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"draw","props":{"segments":[{"type":"free","points":[{"x":0,"y":0,"z":0.5},{"x":-0.16,"y":0.01,"z":0.5},{"x":-1.12,"y":0.38,"z":0.5},{"x":-3.02,"y":1.6,"z":0.5},{"x":-5.63,"y":3.97,"z":0.5},{"x":-9,"y":7.64,"z":0.5},{"x":-12.42,"y":12.09,"z":0.5},{"x":-15.44,"y":16.86,"z":0.5},{"x":-17.78,"y":21.04,"z":0.5},{"x":-19.74,"y":25.18,"z":0.5},{"x":-21.83,"y":29.82,"z":0.5},{"x":-23.45,"y":33.78,"z":0.5},{"x":-24.51,"y":37.42,"z":0.5},{"x":-25.3,"y":41.13,"z":0.5},{"x":-25.77,"y":44.61,"z":0.5},{"x":-26.05,"y":47.66,"z":0.5},{"x":-26.17,"y":50.48,"z":0.5},{"x":-26.17,"y":53.36,"z":0.5},{"x":-26.17,"y":56.41,"z":0.5},{"x":-25.96,"y":59.38,"z":0.5},{"x":-25.37,"y":62.38,"z":0.5},{"x":-24.57,"y":65.31,"z":0.5},{"x":-23.72,"y":67.78,"z":0.5},{"x":-22.83,"y":69.95,"z":0.5},{"x":-21.98,"y":71.79,"z":0.5},{"x":-21.17,"y":73.31,"z":0.5},{"x":-20.39,"y