,"id":"shape:luNlFec4icLJobEkZY9NO","typeName":"shape"},{"x":620.2025688519061,"y":145.01406598957146,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":575.9232496562945,"text":"NAVIGAZIONE\nPuoi  muovervi liberamente all'interno della board in fase esplorativa. \n\nDurante le attività, è consigliato seguire il facilitatore. Come? Cliccando sul suo nome in alto a destra.","font":"sans","autoSize":false,"scale":1,"textAlign":"start"},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aH","id":"shape:tM57FhX1lmMu4WKAxVyJI","typeName":"shape"},{"x":588.7732506091525,"y":330.86363703840925,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"image","props":{"w":297.1743267839882,"h":198.15301676414543,"assetId":"asset:-717294035","playing":true,"url":"","crop":{"topLeft":{"x":0,"y":0},"bottomRight":{"x":0.9861981425227018,"y":1}}},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aJ","id":"shape:qt-sELl3kJ99WC1Dcw4Uw","typeName":"shape"},{"x":2.7156784998560397,"y":122.86999999999989,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"draw","props":{"segments":[{"type":"free","points":[{"x":0,"y":0,"z":0.5},{"x":0.26,"y":0,"z":0.5},{"x":1.88,"y":0,"z":0.5},{"x":5.75,"y":0,"z":0.5},{"x":11.25,"y":0,"z":0.5},{"x":43.43,"y":-19.3,"z":0.5},{"x":51,"y":-29.23,"z":0.5},{"x":54.47,"y":-34.55,"z":0.5},{"x":57.67,"y":-40.12,"z":0.5},{"x":60.38,"y":-45.87,"z":0.5},{"x":62.77,"y":-51.86,"z":0.5},{"x":65.3,"y":-58.5,"z":0.5},{"x":67.46,"y":-64.69,"z":0.5},{"x":68.92,"y":-70.34,"z":0.5},{"x":70.12,"y":-76.32,"z":0.5},{"x":71.23,"y":-81.96,"z":0.5},{"x":72.04,"y":-88.01,"z":0.5},{"x":72.47,"y":-94.92,"z":0.5},{"x":72.8,"y":-102.24,"z":0.5},{"x":72.97,"y":-108.81,"z":0.5},{"x":72.97,"y":-113.82,"z":0.5},{"x":72.97,"y":-117.49,"z":0.5},{"x":72.97,"y":-119.93,"z":0.5},{"x":72.97,"y":-121.45,"z":0.5},{"x":72.97,"y":-122.42,"z":0.5},{"x":72.97,"y":-122.87,"z":0.5}]}],"color":"grey","fill":"none","dash":"draw","size":"s"