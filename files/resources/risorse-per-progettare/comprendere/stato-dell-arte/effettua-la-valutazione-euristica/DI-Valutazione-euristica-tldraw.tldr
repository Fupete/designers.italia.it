ght":{"x":0.8449869789025022,"y":0.6779603301681549}}},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"aG","typeName":"shape"},{"x":1347.4523263978426,"y":-1922.9749129797742,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:FzjY1rgw_wx6g0b5Gzaep","type":"text","props":{"color":"light-blue","size":"xl","w":1315.8324404083246,"text":"Usa questa sezione per analizzare il sito secondo l’euristica","font":"sans","textAlign":"middle","autoSize":true,"scale":1.1073627512197186},"parentId":"page:page","index":"b0T","typeName":"shape"},{"x":56.42268163296467,"y":31.62863787795277,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:tdTxEGLfZ1qnScZ_zZqQn","type":"text","props":{"color":"light-blue","size":"xl","w":740.359375,"text":"Usa questa sezione per analizzare il sito secondo l’euristica","font":"sans","textAlign":"middle","autoSize":true,"scale":1.1073627512197186},"parentId":"shape:pba241OaBasnxlNxkIpOq","index":"aG","typeName":"shape"},{"x":67.70961686258715,"y":48.49861729106556,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:c0jzk-5HDPXUCpc30ufo0","type":"text","props":{"color":"light-blue","size":"xl","w":477.875,"text":"Scopo della valutazione","font":"sans","textAlign":"middle","autoSize":true,"scale":1.1073627512197186},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"a8","typeName":"shape"},{"x":70.29222657239643,"y":157.47919697477255,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:tfRfDqwhQ-jsvjO74Lp61","type":"text","props":{"color":"black","size":"s","w":1031.9464625152666,"text":"Definisci l’obiettivo della riprogettazione\nElenca le motivazioni per cui si sta svolgendo l'analisi, pensando a tutti i principali dispositivi che l'utente può utilizzare, e scrivile nei post-it appositi (es.: Identificare percorsi più efficaci per raggiungere sezioni e contenuti)\n\nSeleziona le euristiche principali\nIn base agli obiettivi che hai definito, cerca di capire quali euristiche risultano più importanti e collegale con una freccia a ciascun obiettivo.\nEventualmente, formula parametri di valutazione ad-hoc se gli obiettivi lo necessitano.","font":"sans","textAlign":"start","autoSize":false,"scale":0.7338319698795609},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"a9","typeName":"shape"},{"x":39.95782300072824,"y":157.47919697477255,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:XgUkiBiRZnUfIWEadXvJU","type":"text","props":{"color":"light-blue","size":"s","w":28.177091710848277,"text":"01","font":"sans","textAlign":"start","autoSize":false,"scale":0.7338319698795609},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"aA","typeName":"shape"},{"x":39.95782300072824,"y":226.66269024454573,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:1v0URLIalEkZ6VzAZuRaA","type":"text","props":{"color":"light-blue","size":"s","w":28.177091710848277,"text":"02","font":"sans","textAlign":"start","autoSize":false,"scale":0.7338319698795609},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"aB","typeName":"shape"},{"x":70.8475028352459,"y":371.4915405773479,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:JVe0VVhZ2rI-yKHZTNPzK","type":"text","props":{"color":"black","size":"s","w":179.0249496774655,"text":"OBIETTIVI","font":"sans","textAlign":"middle","autoSize":false,"scale":1.1073627512197186},"parentId":"shape:bA-kQ0SANQ408FCPGv6hf","index":"aC","typeName":"shape"},{"x":-2187.025672641022,"y":-1544.9783198330144,"rotation":0,"isLocked":false,"opacity":0.75,"meta":{},"id":"shape:yvmnIFezQTIV3Re0A3jxx","type":"note","props":{"color":"violet","size":"s","text":"es.: L'utente può usare i TAG per filtrare i contenuti più pertinenti","font":"sans","align":"start","verticalAlign":"start","growY":0,"fontSizeAdjustment":18,"url":"","scale":1},"parentId":"page:page","index":"b0V","typeName":"shape"},{"x":333.41628866851397,"y":371.4915405773479,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"id":"shape:eZacXHB_cNhVqjue64pYj","type":"text","