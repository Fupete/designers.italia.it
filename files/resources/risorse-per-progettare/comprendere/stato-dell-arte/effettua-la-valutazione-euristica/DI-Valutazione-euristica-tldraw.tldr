":1,"meta":{},"type":"text","props":{"color":"black","size":"xl","w":17.821619277442345,"text":"","font":"draw","autoSize":true,"scale":1.1073627512197186,"textAlign":"middle"},"parentId":"page:page","index":"at","id":"shape:yDRxbz-KJpgiXEFTSngCa","typeName":"shape"},{"x":1337.4521033355895,"y":153.5816994132033,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":494.05547142145224,"text":"POST-IT\nPer generare un post-it seleziona l'apposita icona nella dalla barra degli strumenti in basso (shortcut: N)\nFunziona anche il classico \"copia e incolla\" della tastiera, per duplicare post-it già presenti sulla board virtuale.\n\n\nFai doppio click all’interno del post-it per iniziare a scrivere.","font":"sans","autoSize":false,"scale":1,"textAlign":"start"},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"a1","id":"shape:2u3qyH3sCSS5GbJ2BW1q_","typeName":"shape"},{"x":1337.4521033355895,"y":387.0933569791382,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"image","props":{"w":444.68422807551633,"h":62,"assetId":"asset:-661475955","playing":true,"url":"","crop":{"topLeft":{"x":0.016185336116114314,"y":0},"bottomRight":{"x":1,"y":1}}},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"a2","id":"shape:A_XQBMTHcrqvQnBajdAhp","typeName":"shape"},{"x":2234.825989642839,"y":277.80730534815757,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"image","props":{"w":134.9376001793853,"h":264.37176624007367,"assetId":"asset:-1297031375","playing":true,"url":"","crop":{"topLeft":{"x":0.06137711445311083,"y":0.007446578345172615},"bottomRight":{"x":1,"y":1}}},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"a3","id":"shape:ThEVBMBQIxrIAie0zBl4u","typeName":"shape"},{"x":1875.708118400772,"y":177.8785744132033,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":494.05547142145224,"text":"Selezionando il post-it, o un qualsiasi elemento è possibile modificar