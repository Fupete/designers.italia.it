"black","fill":"pattern","dash":"dotted","size":"s","font":"sans","text":"","align":"middle","verticalAlign":"middle","growY":0,"url":"","scale":1},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aG","id":"shape:Fo49XMLK0XhkiieLKV6gy","typeName":"shape"},{"x":3194.985869127996,"y":104.80383080432239,"rotation":0,"isLocked":true,"opacity":1,"meta":{},"type":"highlight","props":{"segments":[{"type":"straight","points":[{"x":0,"y":0,"z":0.5},{"x":385.60087181452906,"y":0,"z":1}]}],"color":"black","size":"s","isComplete":true,"isPen":false,"scale":1},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aK","id":"shape:grYvhosQ2C_ENxOudfQsW","typeName":"shape"},{"x":3193.5325239932663,"y":92.65539330432239,"rotation":0,"isLocked":true,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":590.7421875,"text":"Prova a creare un post-it e scrivere il tuo nome!","font":"sans","autoSize":true,"scale":1,"textAlign":"middle"},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aL","id":"shape:kk-uaPZMbWvZYhtHQ4mgw","typeName":"shape"},{"x":49.4302010878273,"y":33.36139821720735,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":756.6034584145372,"text":"Organizza il lavoro collaborativo\nCondividi questa lavagna con tutti coloro che saranno coinvolti nell’attività di valutazione collettiva, utilizza il pulsante blu in alto a destra ‘Condividi’ per copiare l'URL.\n\nDichiara gli obiettivi\nElenca gli obiettivi della valutazione e seleziona le euristiche più pertinenti, puoi chiedere agli altri partecipanti di validarli e aggiungerne se ne mancano (prima o durante la sessione).\n\nPrepara la lavagna per la valutazione\nPer ciascuna euristica selezionata crea una copia della sezione di valutazione, 'Valutazione -Euristica X', riporta l’euristica scelta (box giallo) e i parametri afferenti (box viola). Poi sotto aggiungi gli screenshot delle schermate che vuoi valutare durante la sessione collaborativa.","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a1","id":"shape:GtiOnMbCbfuxzJ4H18gZR","typeName":"shape"},{"x":22.036825666578807,"y":33.36139821720735,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"light-blue","size":"s","w":28.177091710848277,"text":"01","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a4","id":"shape:AheCYe_BjOVvTRiN1oWJE","typeName":"shape"},{"x":22.036825666578807,"y":96.8199510032864,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"light-blue","size":"s","w":28.177091710848277,"text":"02","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a7","id":"shape:bLGAZBx5ZIVFWFz_-LWJ1","typeName":"shape"},{"x":40.709343495875146,"y":266.37996222652805,"rotation":0,"isLocked":false,"opacity":0.25,"meta":{},"type":"geo","props":{"w":520.9804448573677,"h":54.68450397259812,"geo":"rectangle","color":"yellow","labelColor":"black","fill":"pattern","dash":"draw","size":"s","font":"sans","text":"","align":"middle","verticalAlign":"middle","growY":0,"url":"","scale":1},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a8","id":"shape:usb9WIh39IyR5lh8nEiZm","typeName":"shape"},{"x":49.4302010878273,"y":277.03467743592705,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":756.6034584145372,"text":"SUGGERIMENTO Per fare lo screenshot a tutta pagina del sito in versione dekstop o mobile, usa una delle tante estensioni per browser disponibili online.","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"aA","id":"shape:kueQQ6Pk3c4-Fvjsfc0Nx","typeName":"shape"},{"x":22.036825666578807,"y":343.62964638689823,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"light-blue","size":"s","w":28.177091710848277,"text":"04","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a6","id":"shape:DLYnNeLhvG4Eq6fDRpJ0h","typeName":"shape"},{"x":49.4302010878273,"y":343.62964638689823,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":756.6034584145372,"text":" Valuta le schermate\nIn ciascuna sezione, utilizza i post-it in alto per scrivere le problematiche che emergono rispetto alla specifica euristica e ai parametri afferenti. Ripeti la stessa cosa per ciascuna euristica selezionata.\n\nCondividi i risultati\nRileggi i post-it insieme a tutto il gruppo, magari sposta vicini quelli che sono simili, e chiedi ai partecipanti di ‘votare’ con uno sticker (es.:    ), così da avere maggior chiarezza su quante/quali problematiche riportare nel Foglio excel di valutazione.","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:Svb6zD2fqAlueRIOfHaxq","index":"a3","id":"shape:iXO_iwHYNpEmP1X8znp1J","typeName":"shape"},{"x":794.1667270906983,"y":999.5273551710192,"rotation":0,"isLocked":false,"opacity":0.25,"meta":{},"type":"geo","props":{"w":520.9804448573677,"h":66.71776705508387,"geo":"rectangle","color":"light-red","labelColor":"black","fill":"pattern","dash":"draw","size":"s","font":"sans","text":"","align":"middle","verticalAlign":"middle","growY":0,"url":"","scale":1},"parentId":"shape:vnRWf31oWnf8UVtyXBVPh","index":"aN","id":"shape:gxowcfzk6li5FvEtGkN3X","typeName":"shape"},{"x":802.8875846826504,"y":1010.1820703804182,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":756.6034584145372,"text":"NOTA BENE Una sessione collaborativa di valutazione euristica è utile per coinvolgere altri stakeholder al tavolo, tuttavia una valutazione euristica esaustiva e completa, richiede più tempo e comprende anche la fase di elaborazione delle raccomandazioni.","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:vnRWf31oWnf8UVtyXBVPh","index":"aO","id":"shape:eAprLwjgxxSeZzXe8-u-m","typeName":"shape"},{"x":88.88696137767056,"y":492.7663397247902,"rotation":0,"isLocked":false,"opacity":0.75,"meta":{},"type":"frame","props":{"w":532.6202627987823,"h":509.05434276477786,"name":"INTRODUZIONE"},"parentId":"shape:vnRWf31oWnf8UVtyXBVPh","index":"aJ","id":"shape:vd3tDjpCxI03Ltl9VT0EK","typeName":"shape"},{"x":20.534525612634752,"y":69.56992738560007,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":724.6094566683784,"text":"La valutazione euristica di un sito web è un’attività che consente di identificare problemi di usabilità attraverso l'analisi delle interfacce di un prodotto digitale in base a una serie di principi  consolidati, generali rispetto all’interazione uomo-macchina, noti come euristiche di Nielsen, in questo caso integrate con parametri specifici per l’ambito dei siti e servizi digitalò della pubblica amministrazione.\n\nQuesta lavagna in particolare può essere utilizzata per analizzare le schermate dell’interfaccia in maniera collaborativa, durante sessioni sincrone o in asincrono, per evidenziare le problematiche di usabilità. \n\nPoi puoi riorganizzare, sintetizzare e riportare i risultati sullo strumento ‘Foglio excel per la valutazione euristica’ (https://designers.italia.it/files/resources/risorse-per-progettare/comprendere/stato-dell-arte/effettua-la-valutazione-euristica/DI-Valutazione-euristica.ods), per procedere poi a formulare raccomandazioni su come migliorare l’esperienza d’uso corrente.","font":"sans","autoSize":false,"scale":0.6626843544008253,"textAlign":"start"},"parentId":"shape:vd3tDjpCxI03Ltl9VT0EK","index":"a6","id":"shape:aDvbxwvxK8BqX-6EsZZlc","typeName":"shape"},{"x":23.946040644829736,"y":31.99909798946328,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"light-blue","size":"s","w":316.7265625,"text":"Introduzione alla valutazione euristica","font":"sans","autoSize":true,"scale":1,"textAlign":"middle"},"parentId":"shape:vd3tDjpCxI03Ltl9VT0EK","index":"a2","id":"shape:4Y48uTOBcJAkt4oDTxbko","typeName":"shape"},{"x":20.270227243964655,"y":320.4168454286448,"rotation":0,"isLocked":false,"opacity":0.25,"meta":{},"type":"geo","props":{"w":480.71594672235824,"h":166.08715632172607,"geo":"rectangle","color":"yellow","labelColor":"black","fill":"pattern","dash":"draw","size":"s","font":"sans","text":"","align":"middle","verticalAlign":"middle","growY":0,"url":"","scale":1},"parentId":"shape:vd3tDjpCxI03Ltl9VT0EK","index":"a3","id":"shape:FnZJl47g-JydFS2dzZnG5","typeName":"shape"},{"x":37.22507999283698,"y":329.7516648468961,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"light-blue","size":"s","w":133.6640625,"text":"Prima di iniziare","font":"sans","autoSize":true,"scale":1,"textAlign":"middle"},"parentId":"shape:vd3tDjpCxI03Ltl9VT0EK","index":"a4","id":"shape:GeXRnYGfSGkZmrD-6iRC7","typeName":"shape"},{"x":40.70777963888213,"y":354.72208408906204,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":647.2294710456816,"text":"→ se non hai mai usato TLDRAW leggi le istruzioni d'usonel canvas qui sopra\n→ leggi le istruzioni su come utilizzare questa lavagna per effettuare la valutazione nel canvas affianco\n→ leggi la descrizione delle euristiche e i relativi parametri di valutazione\n→ esplora l’esempio di valutazione di una delle euristiche","font":"sans","autoSize":false,"scale":0.6934924184364979,"textAlign":"start"},"parentId":"shape:vd3tDjpCxI03Ltl9VT0EK","index":"a6G","id":"shape:Ak8fxc2LdbabGPxHr5Hh6","typeName":"shape"},{"x":753.4573835948231,"y":492.7663397247902,"rotation":0,"isLocked":false,"opacity":0.75,"meta":{},"type":"frame","props":{"w":590.7764879980277,"h":616.8988410350254,"name":"ISTRUZIONI"},"parentId":"shape:vnRWf31oWnf8UVtyXBVPh","index":"a4","id":"shape:Svb6zD2fqAlueRIOfHaxq","typeName":"shape"},{"x":-2599.50824489248,"y":-2962.339167686626,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":494.05547142145224,"text":"STAMPA / ESPORTAZIONE\n\nPer esportare in SVG, PNG, JSON:\nseleziona una \"cornice\" (es: la Service Blueprint) > \ntasto destro > esporta come\n\nPer stampare o salvare i PDF:\nseleziona una \"cornice\" (es: la Service Blueprint) > menu in alto a sinistra> file > stampa","font":"sans","autoSize":false,"scale":1,"textAlign":"start"},"parentId":"page:page","index":"b0H","id":"shape:HSvWiifWKfotoy5e6ZExG","typeName":"shape"},{"x":2475.8318695221865,"y":153.50083889731286,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"text","props":{"color":"black","size":"s","w":494.0554714214508,"text":"ARTBOARD / CORNICI\nPuoi creare una nuova cornice vuota o attorno ad elementi esistenti, utilizzando la barra degli strumenti in basso.","font":"sans","autoSize":false,"scale":1,"textAlign":"start"},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"a1G","id":"shape:fYcLD0Lkz5UMw4PhTgf0Q","typeName":"shape"},{"x":2486.8137634256186,"y":249.3503323391078,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"image","props":{"w":214.98254059163918,"h":196.69956793135316,"assetId":"asset:-338055316","playing":true,"url":"","crop":null},"parentId":"shape:463_crI36SUS8OOi-JN9s","index":"aM","id":"shape:vSbyFJOMwcG0oq4csZb2y","typeName":"shape"},{"x":2626.7334963655962,"y":382.77702785890506,"rotation":0,"isLocked":false,"opacity":1,"meta":{},"type":"draw","props":{"segments":[{"type":"free","points":[{"x":0,"y":0,"z":0.5},{"x":-0.04,"y":0,"z":0.5},{"x":-0.15,"y":0,"z":0.5},{"x":-0.44,"y":0,"z":0.5},{"x":-0.87,"y":0,"z":0.5},{"x":-1.58,"y":0,"z":0.5},{"x":-2.6,"y":0,"z":0.5},{"x":-4.22,"y":0,"z":0.5},{"x":-6.55,"y":0.28,"z":0.5